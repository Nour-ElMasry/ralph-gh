# ralph-gh.conf - Global configuration
# Copy to ~/.ralph-gh/ralph-gh.conf and edit
#
# Repo and workspace are auto-detected from CWD (just cd into your repo).
# Override per-repo settings in .ralphrc at your repo root.

# Optional (defaults shown)
RALPH_GH_LABEL="ralph"                    # Label that triggers automation
RALPH_GH_SKIP_LABEL=""                    # Optional hold label (HITL). Issues with this label
                                           # are deferred: parents are skipped at poll time, held
                                           # sub-issues do not block their dependents (those run
                                           # anyway), and the parent is left open with the held
                                           # slice unchecked so a future run can resume it after
                                           # a human removes the label. Empty = feature disabled.
RALPH_GH_MAIN_BRANCH="main"              # Base branch for PRs
CLAUDE_TIMEOUT_MINUTES=15                 # Max time per sub-issue

# Permissions. ralph-gh runs Claude in `--permission-mode auto` (a classifier
# approves tool calls; nothing blocks waiting for a human). The allow list
# below is a fast path that skips the classifier for known-safe tools; anything
# NOT listed is still allowed if the classifier approves it. The deny list is a
# hard stop that auto mode cannot override.
RALPH_GH_PERMISSION_MODE="auto"           # auto | acceptEdits | dontAsk | manual
RALPH_GH_DENY_RULES="Bash(git push --force*),Bash(git push -f*),Bash(git push origin --delete*),Bash(git push --delete*),Bash(git reset --hard*),Bash(git clean*),Bash(git branch -D*),Bash(git checkout main*),Bash(git checkout master*),Bash(git switch main*),Bash(git switch master*),Bash(git worktree*),Bash(git stash drop*),Bash(gh pr merge*),Bash(gh pr create*),Bash(gh issue close*),Bash(gh issue edit*),Bash(rm -rf /*),Bash(rm -rf ~*)"
RALPH_GH_SETTING_SOURCES="user,project,local"   # named explicitly so repo hooks/skills keep loading if --bare becomes the -p default
RALPH_GH_ALLOWED_TOOLS="Write,Read,Edit,Bash(git add *),Bash(git commit *),Bash(git diff *),Bash(git log *),Bash(git status),Bash(git status *),Bash(git push *),Bash(git pull *),Bash(git fetch *),Bash(git checkout *),Bash(git branch *),Bash(git stash *),Bash(git merge *),Bash(git tag *),Bash(npm *),Bash(pnpm *),Bash(node *),Bash(find *)"

# Models. Implementation defaults to $ANTHROPIC_MODEL (set it in .ralphrc), then
# Opus 5. The verifier, review and reconcile passes run on Sonnet 5.
RALPH_GH_MODEL=""                         # empty = ANTHROPIC_MODEL, then claude-opus-5
RALPH_GH_VERIFIER_MODEL="claude-sonnet-5" # independent read-only grader
RALPH_GH_REVIEW_MODEL="claude-sonnet-5"   # pre-PR /review-best-practices pass
RALPH_RECONCILER_MODEL="claude-sonnet-5"  # parallel-merge reconciliation
RALPH_GH_FALLBACK_MODEL="claude-sonnet-5" # --fallback-model when the primary is overloaded ("" disables)
RALPH_GH_EFFORT=""                        # low|medium|high|xhigh|max; empty = CLAUDE_CODE_EFFORT_LEVEL
RALPH_GH_MAX_BUDGET_USD=""                # --max-budget-usd per Claude call; empty = no cap

# Gates (run after EVERY Claude turn, in this order; any failure re-invokes
# Claude with the failure as context):
#   1. acceptance — the model's structured report, one entry per `- [ ]` item
#   2. verify     — the shell runs the repo's test/build command itself
#   3. verifier   — a separate read-only Claude session grades the diff
RALPH_GH_VERIFY_CMD=""                    # empty = <repo>/.ralph/verify.sh if present, else the gate is skipped (WARN)
RALPH_GH_VERIFY_TIMEOUT_MINUTES=15
RALPH_GH_VERIFIER_ENABLED=1
RALPH_GH_VERIFIER_TIMEOUT_MINUTES=10

# Telemetry: one JSON line per Claude call / gate verdict / parent outcome.
# Survives worktree cleanup. Read it with `ralph-gh --stats`.
RALPH_GH_TELEMETRY_FILE="$HOME/.ralph-gh/telemetry.jsonl"

# Loop control
RALPH_GH_MAX_LOOPS_PER_ISSUE=5           # Max Claude invocations per sub-issue (retries until complete)
RALPH_GH_MAX_LOOPS_TOTAL=0              # Max total invocations per parent group (0=unlimited)

# Circuit breaker thresholds
CB_NO_PROGRESS_THRESHOLD=3               # Open after N sub-issues with no progress
CB_SAME_ERROR_THRESHOLD=5                # Open after N repeated errors

# Resource caps. Every `ralph-gh run` re-executes itself inside a transient
# systemd scope under ONE shared slice, so however many runs you start at once,
# their Claude sessions, test workers, typechecks and builds share a single
# memory ceiling. Hitting it OOM-kills the largest process inside the slice
# (one test worker, one build) instead of stalling the whole machine. Needs
# `systemd-run --user`; where that is missing the run proceeds uncapped with a
# WARN. Size MemoryMax to what the box can spare beside your interactive work.
RALPH_GH_CGROUP=1                        # 0 = never re-exec, run uncapped
RALPH_GH_CGROUP_SLICE="ralph.slice"
RALPH_GH_MEMORY_MAX="6G"                 # shared by every concurrent run
RALPH_GH_MEMORY_SWAP_MAX="0"             # 0 = fail fast rather than thrash into swap
RALPH_GH_CPU_WEIGHT=50                   # default weight is 100; interactive work wins ties

# Parallel execution (experimental — disabled by default)
# When 0, every parent runs its sub-issues serially regardless of any
# `max_parallel` field declared in the PRD DAG. When 1, parents whose DAG
# declares parallelism and whose RALPH_MAX_PARALLEL is >1 will hand off to
# the parallel scheduler (lib/parallel_orchestrator.sh).
# Known issue: env-dependent post-merge verify (e.g. Next.js builds reading
# gitignored .env files) can cascade-fail across parallel sub-worktrees, which
# is why the default is off. Re-enable only if your post-merge gate is
# environment-independent.
RALPH_PARALLEL_ENABLED=0
RALPH_MAX_PARALLEL=1                     # Honored only when RALPH_PARALLEL_ENABLED=1
